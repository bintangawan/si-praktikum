# App: use http://localhost:3000 locally; set the canonical HTTPS domain on Vercel.
NEXT_PUBLIC_APP_NAME=SI Praktikum
APP_DESCRIPTION=Sistem Informasi Praktikum
APP_URL=http://localhost:3000
SESSION_COOKIE_NAME=si_praktikum_session
SESSION_TTL_DAYS=14
BCRYPT_ROUNDS=12
NEXT_PUBLIC_DEFAULT_LOCALE=id
NEXT_PUBLIC_LOCALE_COOKIE_NAME=si_praktikum_locale
LOCALE_COOKIE_TTL_DAYS=365

# Supabase PostgreSQL transaction-mode pooler (6543).
# Replace the password with the URI-encoded password from Supabase Dashboard > Connect.
DATABASE_URL=postgresql://postgres.rgrrrbcyetetfsiekoxn:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require
# Optional URL for Drizzle migrations (direct connection or session pooler on port 5432).
# If blank, Drizzle falls back to DATABASE_URL.
DATABASE_MIGRATION_URL=postgresql://postgres:[YOUR-PASSWORD]@db.rgrrrbcyetetfsiekoxn.supabase.co:5432/postgres?sslmode=require
DB_POOL_MAX=1
DB_CONNECT_TIMEOUT=10
DB_IDLE_TIMEOUT=20

# Provision this private Storage bucket with `npm run db:storage`.
SUPABASE_URL=https://rgrrrbcyetetfsiekoxn.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Daily 00:00 WIB = 17:00 UTC. Activate after filling the DB password: npm run db:keepalive
SUPABASE_KEEPALIVE_CRON_UTC="0 17 * * *"
# Server-only key from Supabase Dashboard > Project Settings > API Keys (sb_secret_...).
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=si-praktikum-files
